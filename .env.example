# Env var list. Copy to .env.local. Values are never committed.
# Nexus runs on http://localhost:3001. Port 3000 is the companion app.

# Firebase (required — app crashes without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin access — comma-separated emails allowed into the admin console.
# Empty = admin routes fail closed (503); the client console treats the
# signed-in user as admin (legacy). Keep in sync with firestore.rules.
NEXT_PUBLIC_ADMIN_EMAILS=

# GitHub — optional fine-grained PAT (repo:read) for "Sync from GitHub".
# Absent = anonymous API (60 req/hr per IP); set to raise the limit to 5,000/hr.
GITHUB_TOKEN=

# Firebase Admin SDK — JSON service-account key (server-side fulfillment writes).
# Used by /api/razorpay/verify, /api/stripe/verify, /api/stripe/webhook and
# /api/github/sync-all. Without it those routes fail at request time.
FIREBASE_SERVICE_ACCOUNT=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Stripe
STRIPE_SECRET_KEY=
# Webhook signing secret shared with /api/stripe/webhook (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL of THIS app (Nexus). Used for Stripe success/cancel redirects.
# Locally the app runs on port 3001; never point this at the companion app.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Canonical public site URL (metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://nexusprods.vercel.app

# Extra browser origins allowed to call the API (comma-separated).
# localhost:3000/3001 and the production domains are always allowed.
ALLOWED_ORIGINS=

# Optional — guarded Vercel Cron header for POST /api/github/sync-all
CRON_SECRET=
