# Firebase (required — app crashes without these)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin access — comma-separated emails allowed into the admin console.
# Empty = any signed-in user is treated as admin (legacy behaviour).
# Keep in sync with the ADMIN_EMAILS list in firestore.rules.
NEXT_PUBLIC_ADMIN_EMAILS=

# GitHub — optional fine-grained PAT (repo:read) for "Sync from GitHub".
# Absent = anonymous API (60 req/hr per IP); set to raise the limit to 5,000/hr.
GITHUB_TOKEN=

# Firebase Admin SDK — JSON service-account key (server-side fulfillment writes).
# Used by /api/razorpay/verify, /api/stripe/verify, /api/stripe/webhook and
# /api/github/sync-all. Without it those routes fail at request time.
FIREBASE_SERVICE_ACCOUNT=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Stripe
STRIPE_SECRET_KEY=
# Webhook signing secret shared with /api/stripe/webhook (checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — guarded Vercel Cron header for POST /api/github/sync-all
CRON_SECRET=
